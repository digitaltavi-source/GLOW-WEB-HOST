PORT=3000
GLOW_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Topology Mode A (Default): Standalone GLOW Web Domain ---
GLOW_DEPLOYMENT_TOPOLOGY=STANDALONE_DOMAIN
GLOW_PUBLIC_ORIGIN=http://127.0.0.1:3000
GLOW_PUBLIC_MCP_URL=http://127.0.0.1:3000/mcp-v2
# GLOW_OAUTH_CALLBACK_URL=https://web.glow.example/auth/google/callback
# GLOW_PREVIEW_ORIGIN=https://preview.glow-sandbox.example

# --- Topology Mode B: Shared Single-Domain GLOW Ecosystem Gateway ---
# GLOW_DEPLOYMENT_TOPOLOGY=SHARED_ECOSYSTEM_GATEWAY
# GLOW_PUBLIC_ORIGIN=https://glow.example
# GLOW_BASE_PATH=/web
# GLOW_PUBLIC_MCP_URL=https://glow.example/web/mcp-v2
# GLOW_OAUTH_CALLBACK_URL=https://glow.example/auth/google/callback
# GLOW_PREVIEW_ORIGIN=https://preview.glow-sandbox.example

# --- Internal Protected Factory Contract ---
GLOW_PROTECTED_SERVICE_URL=https://protected-web-factory.example
GLOW_PROTECTED_SERVICE_TOKEN=replace-at-deployment

# --- Authentication & RFC 8707 Resource-Scoped OAuth 2.1 ---
GLOW_AUTH_MODE=static_bearer
GLOW_PUBLIC_TEST_BEARER_TOKEN=replace-with-32-plus-character-secret
GLOW_PUBLIC_TEST_SUBJECT=hostinger-web-test-user
# Static bearer is DEVELOPMENT only. DEMO/PRODUCTION require OAuth and an action scope.
# GLOW_GATEWAY_PROFILE=DEMO
# GLOW_OAUTH_ISSUER=https://glow.example
# GLOW_OAUTH_AUDIENCE=https://glow.example/web/mcp-v2
# GLOW_OAUTH_JWKS_URL=https://glow.example/.well-known/jwks.json
# GLOW_OAUTH_REQUIRED_SCOPES=web.run

# --- Private Operator Channel (loopback only, never an MCP tool) ---
# GLOW_OPERATOR_PORT=3101
# GLOW_OPERATOR_BEARER_TOKEN=
# GLOW_OPERATOR_ID=
# GLOW_OPERATOR_TOKEN_EXPIRES_AT=<unix-seconds>
# GLOW_OPERATOR_ALLOWED_SUBJECTS=["<authenticated-mission-owner-subject>"]
