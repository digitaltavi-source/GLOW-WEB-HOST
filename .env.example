# GLOW-WEB-HOST — Hostinger combined one-domain deployment
# PUBLIC repo: digitaltavi-source/GLOW-WEB-HOST
# PRIVATE runtime source: digitaltavi-source/GLOW-WEB-FACTORY
# Hostinger app/domain: lightsteelblue-newt-327142.hostingersite.com

PORT=3000
NODE_ENV=production

GLOW_ALLOWED_HOSTS=lightsteelblue-newt-327142.hostingersite.com
GLOW_PUBLIC_MCP_URL=https://lightsteelblue-newt-327142.hostingersite.com/mcp-v2

# One-process / one-domain combined runtime.
GLOW_PROTECTED_INPROCESS=1
GLOW_PRIVATE_REPO_OWNER=digitaltavi-source
GLOW_PRIVATE_REPO_NAME=GLOW-WEB-FACTORY
GLOW_PRIVATE_FACTORY_SHA=e753190a8a2fa32981c7a99dcec7a11704e8fcf6

# REQUIRED SECRET: fine-grained GitHub token with READ-ONLY Contents access
# to GLOW-WEB-FACTORY only. Store only in Hostinger Environment Variables.
GLOW_PRIVATE_REPO_TOKEN=REPLACE_WITH_FINE_GRAINED_READ_ONLY_PRIVATE_REPO_TOKEN

# Runtime staging path inside Hostinger deployment; generated during build and gitignored.
GLOW_PRIVATE_RUNTIME_ROOT=.glow-private-runtime

# Initial bootstrap auth. Convert to hybrid/oauth only after readiness is verified.
GLOW_AUTH_MODE=static_bearer
GLOW_PUBLIC_TEST_SUBJECT=hostinger-web-test-user
GLOW_PUBLIC_TEST_BEARER_TOKEN=REPLACE_WITH_NEW_RANDOM_32_PLUS_CHARACTER_SECRET

# Optional persistent-state root. If omitted, runtime uses the hosting user's home directory.
# GLOW_PERSISTENT_STATE_ROOT=/absolute/persistent/path

# ---- OAuth production path: enable only after public + private readiness PASS ----
# GLOW_AUTH_MODE=oauth
# GLOW_OAUTH_ISSUER=https://<identity-project>/auth/v1
# GLOW_OAUTH_AUDIENCE=authenticated
# GLOW_OAUTH_JWKS_URL=https://<identity-project>/auth/v1/.well-known/jwks.json
# GLOW_OAUTH_REQUIRED_SCOPES=email
# GLOW_PUBLIC_AUTHORIZATION_SERVER=https://lightsteelblue-newt-327142.hostingersite.com
# GLOW_SUPABASE_URL=https://<identity-project>.supabase.co
# GLOW_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
